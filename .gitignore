# ============================================================
# FastAPI 自动化测试平台 - Git 忽略文件
# ============================================================

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 日志文件
logs/
*.log

# 数据库
*.sqlite3
*.db

# Runner 本地运行配置（勿提交真实密码；开发可用 profiles/local.env + RUNNER_LEGACY=1）
runner/.env
runner/profiles/local.env
runner/profiles/online.env
runner/logs/
runner/venv/
# Playwright 本地下载的浏览器（体积大，各环境自行 playwright install）
runner/browsers/
# 本地启动标记（start-local 等生成的状态文件）
runner/LOCAL
video/
*.png
*.jpg
*.jpeg
*.gif
*.webm
*.mp4

# 例外：前端静态资源需要提交
!frontend/src/assets/**/*
!frontend/public/**/*

# 例外：CE README 功能演示截图/GIF（assets/readme/，已迁移至 docs-site/public/demo/）
!assets/readme/**

# 例外：文档站功能演示高清截图
!docs-site/public/demo/**

# 例外：showcase 静态演示页截图
!showcase/demo/**

# 临时文件
tmp/
temp/
*.tmp

# Docker 镜像离线包（用于无网络环境部署）
*.tar

# 系统文件
.DS_Store
Thumbs.db

# 构建产物
dist/
build/
scripts/.cache/
*.egg-info/

# 前端
frontend/node_modules/
frontend/dist/
frontend/.env

# 后端迁移文件（可选，根据团队规范）
# backend/migrations/

# 后端本地运行时上传（已改用 MinIO 时使用本地回退目录）
backend/app/static/ai_requirements/

# 其他敏感文件
*.pem
*.key
*.cert
