# 本地 / Docker 开发环境变量示例（复制为 backend/.env，勿提交 Git）
BASE_URL=http://localhost:8000
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=admin
DATABASE_PASSWORD=BrickCore123456
DATABASE_NAME=fastapi
MQ_HOST=localhost
MQ_PORT=25672
MQ_USERNAME=admin
MQ_PASSWORD=BrickCore123456
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_DB=15
SCHEDULER_REDIS_DB=7
REDIS_PASSWORD=BrickCore123456
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9200
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=BrickCore123456
MINIO_BUCKET=test-results
AI_REQUIREMENT_BUCKET=ai-requirements
MINIO_SECURE=false
DOC_USERNAME=admin
DOC_PASSWORD=BrickCore123456
INTERNAL_API_KEY=brickcore-internal-demo
UI_EXECUTION_STALE_MINUTES=30
# CORS 额外来源（逗号分隔；默认已含 localhost）。生产/演示 IP 只写部署机 .env，勿写进源码
# CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080,http://your.example.com
# 平台 / 执行器版本（Docker 部署时也可写在根目录 docker-compose.yml 的 backend.environment）
PLATFORM_VERSION=1.5.0
RUNNER_CLIENT_VERSION_LATEST=1.5.5
RUNNER_CLIENT_VERSION_MIN=1.3.8
RUNNER_ENGINE_VERSION=1.1.1
RUNNER_ENGINE_VERSION_MIN=1.0.0
# 可选：网盘下载兜底外链；执行器对外 MQ/Redis（未设时会尝试从 MINIO_PUBLIC_ENDPOINT 推导主机）
# RUNNER_CLIENT_DOWNLOAD_URL=
# RUNNER_MQ_PUBLIC_HOST=
# RUNNER_MQ_PUBLIC_PORT=25672
# RUNNER_REDIS_PUBLIC_HOST=
# RUNNER_REDIS_PUBLIC_PORT=26379
