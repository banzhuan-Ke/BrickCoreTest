# BrickCore 环境变量说明（docker compose 从根目录 .env 读取中间件密码）
# 在仓库根目录复制本文件为 .env，填写下方中间件密码（勿提交 Git）

# --- 中间件（与 docker-compose.yml 中 ${VAR} 对应）---
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
# REDIS_PASSWORD=
# RABBITMQ_PASSWORD=
# MINIO_ROOT_USER=admin
# MINIO_PASSWORD=

# --- 平台演示登录仍为 admin / BrickCore123456（在 database.sql seed，非本文件）---

BASE_URL=http://localhost:8000
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=admin
DATABASE_NAME=fastapi
MQ_HOST=localhost
MQ_PORT=25672
MQ_USERNAME=admin
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_DB=15
SCHEDULER_REDIS_DB=7
MINIO_ENDPOINT=localhost:9200
MINIO_SECURE=false
MINIO_BUCKET=test-results
AI_REQUIREMENT_BUCKET=ai-requirements
STORAGE_TYPE=minio
DOC_USERNAME=admin
DOC_PASSWORD=BrickCore123456
INTERNAL_API_KEY=brickcore-internal-demo

# --- 平台 / 执行器版本（推荐写在 docker-compose.yml backend.environment；本地非 Docker 可写 backend/.env）---
# PLATFORM_VERSION=1.6.0
# RUNNER_CLIENT_VERSION_LATEST=1.6.1
# RUNNER_CLIENT_VERSION_MIN=1.3.8
# RUNNER_ENGINE_VERSION=1.6.1
